<Window x:Class="KIT.BuW.AdvEnrichment.BuildingPropertiesEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:src="clr-namespace:CustomControls;assembly=MultiComboBox"
        xmlns:map="clr-namespace:MapControl;assembly=MapControl.WPF"
        xmlns:tools="clr-namespace:MapControl.UiTools;assembly=MapUiTools.WPF"
        xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment"
        xmlns:ui="clr-namespace:KIT.BuW.AdvEnrichment.UI"
        mc:Ignorable="d"
        Width="1024"
        Height="900"
        Title="ADE Properties Editor"
        d:DesignHeight="200"
        d:DesignWidth="400"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Icon="./Resources/enerlab5.png">

  <Grid>
    <Grid.Resources>
      <Style x:Key="Heading1"
               TargetType="Label">
        <Setter Property="FontWeight"
                  Value="Bold" />
        <Setter Property="FontSize"
                  Value="14" />
        <Setter Property="Padding"
                  Value="20 5 50 5" />
      </Style>

      <Style x:Key="HeaderLabel1"
               TargetType="Label">
        <Setter Property="FontStyle"
                  Value="Italic" />
        <Setter Property="FontSize"
                  Value="10" />
      </Style>
      <Style TargetType="Rectangle">
        <Setter Property="Height"
                  Value="5" />
        <Setter Property="Fill"
                  Value="LightBlue" />
        <Setter Property="Margin"
                  Value="100 8" />
      </Style>

    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.Resources>
        <Style TargetType="Label">
          <Setter Property="Padding"
                  Value="10 0" />
        </Style>
        <Style TargetType="Label"
               x:Key="ValueItem">
          <Setter Property="Padding"
                  Value="10 0" />
          <Setter Property="FontWeight"
                  Value="Bold" />
        </Style>
        <Style TargetType="RadioButton"
               BasedOn="{StaticResource {x:Type ToggleButton}}">
          <Setter Property="Margin"
                  Value="5 5" />
          <Setter Property="Padding"
                  Value="5 5" />
        </Style>
      </Grid.Resources>

    </Grid>

    <TabControl x:Name="tabCtrlConfig"
                Grid.Row="1"
                TabStripPlacement="Left">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Padding"
                  Value="10 5" />
          <Setter Property="Width"
                  Value="200" />
          <!--<Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Button Content="{Binding Path=TextBlock.Text}"></Button>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="False">
                    <Setter Property="Background"
                            Value="Red" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>-->
        </Style>
      </TabControl.Resources>

      <TabItem x:Name="tabItemModelInfo"
               Header="Model information">
        <DockPanel>
          <DockPanel.Resources>
            <Style TargetType="WebBrowser">
              <Setter Property="Margin"
                      Value="3" />
            </Style>
          </DockPanel.Resources>
          <StackPanel DockPanel.Dock="Top">
            <ui:DataOverview />
          </StackPanel>

          <DockPanel DockPanel.Dock="Bottom" >
            <ui:MapOverview x:Name="uiMap" />
          </DockPanel>
        </DockPanel>
      </TabItem>

      <TabItem x:Name="AutoFileStats"
               Header="Buildings Statistics">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Orientation="Vertical">
            <ui:BuildingStats/>
            <ui:BuildingPartStats x:Name="bldgParts"/>
            <ui:ThermalZoneStats/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="AutoEnrichment"
               Header="Auto Enrichment">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Orientation="Vertical">
            <StackPanel.Resources>
              <Style TargetType="Label">
                <Setter Property="Padding"
                        Value="5" />
              </Style>
              <Style TargetType="TextBox">
                <Setter Property="Padding"
                        Value="2" />
                <Setter Property="Margin"
                        Value="3" />
                <Setter Property="FontWeight"
                        Value="Bold" />
              </Style>
              <Style TargetType="ComboBox">
                <Setter Property="Padding"
                        Value="2" />
                <Setter Property="FontWeight"
                        Value="Bold" />
                <Setter Property="Margin"
                        Value="3" />
              </Style>
              <Style TargetType="CheckBox">
                <Setter Property="Padding"
                        Value="2" />
                <Setter Property="Margin"
                        Value="3" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
              </Style>
              <Style TargetType="Image">
                <Setter Property="Height"
                        Value="24" />
              </Style>
              <Style TargetType="RadioButton">
                <Setter Property="Margin"
                        Value="3 10 3 3" />
              </Style>
            </StackPanel.Resources>
            <Grid x:Name="gridFilterHeader">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="60" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!--  -->
              <CheckBox x:Name="Check_ActivateFilter"
                       Grid.Row="0"
                       Grid.Column="0"
                       HorizontalAlignment="Right"
                       IsChecked="True"
                       Checked="CheckBox_ActivateFilter"
                       Unchecked="CheckBox_ActivateFilter"/>
              <Label Grid.Row="0"
                       Grid.Column="1"
                       HorizontalAlignment="Left"
                       Content="Automatic Enrichment" />

              <!--  -->
              <Label x:Name="Text_NoBuildings"
                       Grid.Row="1"
                       Grid.Column="0"
                       HorizontalAlignment="Right"
                       Content="Total Number of Buildings" />
              <TextBox x:Name="NoBuildings"
                       Grid.Row="1"
                       Grid.Column="1"
                       IsReadOnly="True"
                       Text="{Binding Path=BuildingStats.TotalBuildings, Mode=OneTime}" />
              <Image Grid.Row="1"
                       Grid.Column="4"
                       Source="./Resources/info.png"
                       Tag="BuildingFunction"
                       ToolTip=""
                       ToolTipOpening="Image_ToolTipOpening" />

              <!--  -->
              <Label x:Name="Text_ConsideredBuildings"
                       Grid.Row="2"
                       Grid.Column="0"
                       HorizontalAlignment="Right"
                       Content="Number of buildings used for enrichment" />
              <TextBox x:Name="ConsideredBuildings"
                       Grid.Row="2"
                       Grid.Column="1"
                       IsReadOnly="True"
                       Text="{Binding Path=BuildingFunctionStats.ConsideredBuildings, Mode=OneTime}" />
              <Image Grid.Row="2"
                       Grid.Column="4"
                       Source="./Resources/info.png"
                       Tag="BuildingFunction"
                       ToolTip=""
                       ToolTipOpening="Image_ToolTipOpening" />
            </Grid>

            <ui:BuildingAutoEnrich x:Name="bldgAutoEnrich"
                                   ChildTextChanged="TextBox_TextChanged_1"
                                   ChildToolTipOpening="Image_ToolTipOpening"/>
            <ui:FunctionAutoEnrich x:Name="functionAutoEnrich"
                                   ChildProfilesChanged="RadioButton_CalculationBasis"
                                   ProfileLevelSelChanged="ProfileLevelSelChanged"
                                   ChildComboSelChanged="Combo_SelectionChanged_UpdateCheckbox"
                                   ChildCheckboxChanged="BuildingFunctionChecked"
                                   ChildToolTipOpening="Image_ToolTipOpening"/>
            <ui:YearOfConstructionAutoEnrich x:Name="yocAutoEnrich"
                                             ChildComboSelChanged="Combo_SelectionChanged_UpdateCheckbox"
                                             ConstructionDefinitionTypeChanged="ConstructionBasisChanged"
                                             SelectionChanged="YearOfConstruction_SelectionChanged"
                                             ChildToolTipOpening="Image_ToolTipOpening"
                                             GenerateYearOfConstruction="yocAutoEnrich_GenerateYearOfConstruction"/>


          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="AutoParams"
               Header="User-Defined Enrichment">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Orientation="Vertical">
            <StackPanel.Resources>
              <Style TargetType="Label">
                <Setter Property="Padding"
                        Value="5" />
              </Style>
              <Style TargetType="TextBox">
                <Setter Property="Padding"
                        Value="2" />
                <Setter Property="Margin"
                        Value="3" />
                <Setter Property="FontWeight"
                        Value="Bold" />
              </Style>
              <Style TargetType="ComboBox">
                <Setter Property="Padding"
                        Value="2" />
                <Setter Property="FontWeight"
                        Value="Bold" />
                <Setter Property="Margin"
                        Value="3" />
              </Style>
              <Style TargetType="CheckBox">
                <Setter Property="Padding"
                        Value="2" />
                <Setter Property="Margin"
                        Value="3" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="HorizontalAlignment"
                        Value="Center" />
              </Style>
              <Style TargetType="Image">
                <Setter Property="Height"
                        Value="24" />
              </Style>
              <Style TargetType="RadioButton">
                <Setter Property="Margin"
                        Value="3 10 3 3" />
              </Style>
            </StackPanel.Resources>

            <ui:BuildingUserDef x:Name="userBuilding"
                                SettingsChanged="UserDefinedSettingsChanged"
                                ChildToolTipOpening="Image_ToolTipOpening"/>
            <ui:BuildingPhysicsUserDef x:Name="userPhysics"
                                       SettingsChanged="UserDefinedSettingsChanged"
                                       ConstructionSetsSelectionChanged="ComboBox_ConstructionSets_SelectionChanged"
                                       ChildToolTipOpening="Image_ToolTipOpening"/>
            <ui:ZoneUserDef x:Name="userZone"
                            SettingsChanged="UserDefinedSettingsChanged"/>
            <ui:OccupancyUserDef x:Name="occupancyUserDef"
                                 SettingsChanged="UserDefinedSettingsChanged"
                                 />

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="tabItemSettings"
               Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Orientation="Vertical">
            <ui:SettingsControl x:Name="uiSettings"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <WrapPanel Grid.Row="2"
               Orientation="Horizontal"
               HorizontalAlignment="Right">
      <WrapPanel.Resources>
        <Style TargetType="{x:Type Button}">
          <Setter Property="Padding"
                  Value="10 5" />
          <Setter Property="Margin"
                  Value="10 5" />
        </Style>
      </WrapPanel.Resources>

      <CheckBox x:Name="OverwriteFileValues"
                Content="Overwrite existing values"
                VerticalAlignment="Center"
                Grid.Row="1"
                Grid.Column="3"
                IsChecked="True" />

      <Button Content="Apply &amp; Close"
              Click="Button_Click_Apply" />
      <Button IsCancel="True"
              Click="Button_Click_Cancel"
              Content="Close" />
    </WrapPanel>


  </Grid>
</Window>
