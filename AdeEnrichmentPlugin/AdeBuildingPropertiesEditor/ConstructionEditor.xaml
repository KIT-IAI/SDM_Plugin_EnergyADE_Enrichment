<Window x:Class="KIT.BuW.AdvEnrichment.AdeBuildingPropertyEditor.ConstructionEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.AdeBuildingPropertyEditor"
        mc:Ignorable="d"
        Title="ConstructionEditor" Height="450" Width="800">
  <StackPanel>
    <TextBox Grid.Row="0"
             Grid.Column="2"
             Text="{Binding Path=m_Construction.Name}"/>
    <Grid>
      <DataGrid x:Name="ConstructionGrid"
                ItemsSource="{Binding m_Construction.Layers}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name"/>
          <DataGridTextColumn Header="Value"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </StackPanel>
</Window>
