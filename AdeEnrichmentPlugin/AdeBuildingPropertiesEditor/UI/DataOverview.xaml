<UserControl x:Class="KIT.BuW.AdvEnrichment.UI.DataOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:src="clr-namespace:CustomControls;assembly=MultiComboBox"
             xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Expander IsExpanded="True">
    <Expander.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="..\Resources\Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Expander.Resources>
    
    <Expander.Header>
      <Label Content="Data Overview"
             Style="{StaticResource Heading1}" />
    </Expander.Header>
    
    <StackPanel Orientation="Vertical">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
          <Style TargetType="Label">
            <Setter Property="Padding"
                              Value="5" />
          </Style>
          <Style TargetType="TextBox">
            <Setter Property="Padding"
                              Value="2" />
            <Setter Property="Margin"
                              Value="3" />
            <Setter Property="FontWeight"
                              Value="Bold" />
          </Style>
          <Style TargetType="ListBox">
            <Setter Property="Margin"
                              Value="3" />
          </Style>
          <Style TargetType="Rectangle">
            <Setter Property="Height"
                              Value="2" />
            <Setter Property="Fill"
                              Value="LightBlue" />
            <Setter Property="Margin"
                              Value="100 8" />
          </Style>
          <Style TargetType="ComboBox">
            <Setter Property="Padding"
                              Value="2" />
            <Setter Property="Margin"
                              Value="3" />
            <Setter Property="FontWeight"
                              Value="Bold" />
          </Style>
          <Style TargetType="src:MultiComboBox">
            <Setter Property="Padding"
                              Value="2" />
            <Setter Property="Margin"
                              Value="3" />
            <Setter Property="FontWeight"
                              Value="Bold" />
          </Style>
        </Grid.Resources>

        <Label Grid.Row="0"
                         Grid.Column="0"
                         HorizontalAlignment="Right">Data Source</Label>
        <Label Grid.Row="1"
                         Grid.Column="0"
                         HorizontalAlignment="Right">Source Description</Label>
        <Label Grid.Row="2"
                         Grid.Column="0"
                         HorizontalAlignment="Right">Item Count</Label>
        <Label Grid.Row="3"
                         Grid.Column="0"
                         HorizontalAlignment="Right">Items</Label>

        <TextBox Grid.Row="0"
                           Grid.Column="1"
                           IsReadOnly="True"
                           Text="{Binding Path=sourceProps.SourceName, Mode=OneTime}" />
        <TextBox Grid.Row="1"
                           Grid.Column="1"
                           IsReadOnly="True"
                           Text="{Binding Path=sourceProps.Description, Mode=OneTime}" />
        <StackPanel Grid.Row="2"
                              Grid.Column="1"
                              Orientation="Horizontal">
          <TextBox IsReadOnly="True"
                             Width="100"
                             Text="{Binding Path=sourceProps.NumItems, Mode=OneTime}" />
          <Label Content="Selected Item Count" />
          <TextBox IsReadOnly="True"
                             Width="100"
                             Text="{Binding Path=checkedItems.Count, Mode=OneWay}" />
        </StackPanel>

        <src:MultiComboBox x:Name="cbMultiComboBox"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     ItemsSource="{Binding Path=modelItems}"
                                     DisplayMemberPath="Key"
                                     SelectedItems="{Binding Path=checkedItems}"
                                     SelectionMode="Multiple"
                                     SelectionChanged="CbMultiComboBox_SelectionChanged">
          <src:MultiComboBox.DisplaySeparator>
            <Ellipse Margin="3,0"
                               Height="4"
                               Width="4"
                               Fill="Black" />
          </src:MultiComboBox.DisplaySeparator>
        </src:MultiComboBox>

      </Grid>

      <StackPanel>
        <Rectangle />
      </StackPanel>

    </StackPanel>

  </Expander>
</UserControl>
