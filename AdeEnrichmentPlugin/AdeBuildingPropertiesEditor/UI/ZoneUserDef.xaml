<local:BaseUserControl x:Class="KIT.BuW.AdvEnrichment.UI.ZoneUserDef"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Expander>
    <Expander.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="..\Resources\Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Expander.Resources>

    <Expander.Header>
      <Label Content="Zone"
                       Style="{StaticResource Heading1}" />
    </Expander.Header>
    
    <StackPanel Orientation="Vertical">
      <StackPanel.Resources>
        <Style TargetType="Label">
          <Setter Property="Padding"
                        Value="5" />
        </Style>
        <Style TargetType="TextBox">
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="Margin"
                        Value="3" />
          <Setter Property="FontWeight"
                        Value="Bold" />
        </Style>
        <Style TargetType="ComboBox">
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="FontWeight"
                        Value="Bold" />
          <Setter Property="Margin"
                        Value="3" />
        </Style>
        <Style TargetType="CheckBox">
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="Margin"
                        Value="3" />
          <Setter Property="VerticalAlignment"
                        Value="Center" />
          <Setter Property="HorizontalAlignment"
                        Value="Center" />
        </Style>
        <Style TargetType="Image">
          <Setter Property="Height"
                        Value="24" />
        </Style>
        <Style TargetType="RadioButton">
          <Setter Property="Margin"
                        Value="3 10 3 3" />
        </Style>
      </StackPanel.Resources>

      <Grid x:Name="gridZoneProperties">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
                         Grid.Column="1"
                         Style="{StaticResource HeaderLabel1}">Value</Label>
        <Label Grid.Row="0"
                         Grid.Column="2"
                         Style="{StaticResource HeaderLabel1}">UoM</Label>
        <Label Grid.Row="0"
                         Grid.Column="3"
                         HorizontalAlignment="Center"
                         Style="{StaticResource HeaderLabel1}">Use</Label>
        <Label Grid.Row="0"
                         Grid.Column="4"
                         HorizontalAlignment="Center"
                         Style="{StaticResource HeaderLabel1}">Info</Label>

        <Label Grid.Row="1"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Single thermal zone" />
        <Label Grid.Row="2"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Is Heated" />
        <Label Grid.Row="3"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Is Cooled" />
        <Label Grid.Row="4"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Is Mechanically ventilated" />
        <CheckBox Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Path=DefaultParameters.singleThermalZone}"
                            Checked="CheckBox_Click" />
        <CheckBox Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Path=DefaultParameters.isHeated}"
                            Checked="CheckBox_Click" />
        <CheckBox Grid.Row="3"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Path=DefaultParameters.isCooled}"
                            Checked="CheckBox_Click" />
        <CheckBox Grid.Row="4"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Path=DefaultParameters.isMechanicallyVentilated}"
                            Checked="CheckBox_Click" />
        <CheckBox x:Name="Check_SingleThermalZone"
                            Grid.Row="1"
                            Grid.Column="3"
                            IsChecked="True"
                            IsEnabled="False" />
        <CheckBox x:Name="Check_IsHeated"
                            Grid.Row="2"
                            Grid.Column="3"
                            IsChecked="True"
                            IsEnabled="False" />
        <CheckBox x:Name="Check_IsCooled"
                            Grid.Row="3"
                            Grid.Column="3"
                            IsChecked="True"
                            IsEnabled="False" />
        <CheckBox x:Name="Check_IsVentilated"
                            Grid.Row="4"
                            Grid.Column="3"
                            IsChecked="True" />
        <Image Grid.Row="1"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="SingleThermalZone"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="2"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="IsHeated"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="3"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="IsCooled"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="4"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="IsMechanicallyVentilated"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
      </Grid>
      <StackPanel>
        <Rectangle />
      </StackPanel>
    </StackPanel>
  </Expander>


</local:BaseUserControl>
