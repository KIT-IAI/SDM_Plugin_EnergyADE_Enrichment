<local:BaseUserControl x:Class="KIT.BuW.AdvEnrichment.UI.FunctionAutoEnrich"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Expander IsExpanded="{Binding MyFuncViewModel.IsExpanded}"
            d:IsExpanded="True">
    <Expander.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="BaseUserControlResources.xaml" />
          <ResourceDictionary Source="..\Resources\Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Expander.Resources>

    <Expander.Header>
      <Label Content="Building Function"
             Style="{StaticResource Heading1}" />
    </Expander.Header>

    <StackPanel Orientation="Vertical">
      <StackPanel.Resources>
        <Style TargetType="Label">
          <Setter Property="Padding" Value="5" />
        </Style>
        <Style TargetType="TextBox">
          <Setter Property="Padding" Value="2" />
          <Setter Property="Margin" Value="3" />
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="ComboBox">
          <Setter Property="Padding" Value="2" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="CheckBox">
          <Setter Property="Padding" Value="2" />
          <Setter Property="Margin" Value="3" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Image">
          <Setter Property="Height" Value="24" />
        </Style>
        <Style TargetType="RadioButton">
          <Setter Property="Margin" Value="3 10 3 3" />
        </Style>

      </StackPanel.Resources>

      <Grid x:Name="gridBuildingFunction">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  -->
        <CheckBox Grid.Row="0"
                  Grid.Column="0"
                  HorizontalAlignment="Right"
                  IsChecked="{Binding MyFuncViewModel.UseBuildingFunction}" 
                  Checked="CheckBox_Use_BuildingFunction"
                  Unchecked="CheckBox_Use_BuildingFunction"/>
        <Label Grid.Row="0"
               Grid.Column="1"
               HorizontalAlignment="Left"
               Content="Include building function (ALKIS codes)" />

        <!--  -->
        <RadioButton Grid.Row="1"
                     Grid.Column="1"
                     Content="Usage profiles according DIN 18599"
                     IsThreeState="False"
                     IsChecked="{Binding MyFuncViewModel.CalculationBasis, Converter={StaticResource BuildingFunctionCalculationBasisToBooleanConverter}, ConverterParameter=DIN18599, Mode=TwoWay}"
                     IsEnabled="{Binding MyFuncViewModel.UseBuildingFunction}"
                     Checked="RadioButton_CalculationBasis" />

        <!--  This database is currently not supported -->
        <RadioButton Grid.Row="2"
                     Grid.Column="1"
                     Content="Usage profiles according SIA 2024"
                     IsThreeState="False"
                     IsChecked="{Binding MyFuncViewModel.CalculationBasis, Converter={StaticResource BuildingFunctionCalculationBasisToBooleanConverter}, ConverterParameter=SIA2024, Mode=TwoWay}"
                     IsEnabled="{Binding MyFuncViewModel.UseBuildingFunction}"
                     Checked="RadioButton_CalculationBasis"
                     Visibility="Collapsed"/>

        <!--  -->
        <RadioButton Grid.Row="3"
                     Grid.Column="1"
                     Content="Individual usages profiles"
                     IsThreeState="False"
                     IsChecked="{Binding MyFuncViewModel.CalculationBasis, Converter={StaticResource BuildingFunctionCalculationBasisToBooleanConverter}, ConverterParameter=Individual, Mode=TwoWay}"
                     IsEnabled="{Binding MyFuncViewModel.UseBuildingFunction}"
                     Checked="RadioButton_CalculationBasis" />

        <!--  -->
        <Label Grid.Row="4"
               Grid.Column="0"
               HorizontalAlignment="Right"
               Content="Building function level" />

        <ComboBox Grid.Row="4"
                  Grid.Column="1"
                  HorizontalContentAlignment="Right"
                  HorizontalAlignment="Left"
                  Width="100"
                  SelectedValuePath="Content"
                  SelectedValue="x000"
                  SelectedIndex="{Binding MyFuncViewModel.BuildingFunctionLevel}"
                  SelectionChanged="Combo_BuildingFunction_Level_SelectionChanged">
          <ComboBox.IsEnabled>
            <MultiBinding Converter="{StaticResource BooleanAndConverter}">
              <!-- 1. Must be enabled via UseBuildingFunction -->
              <Binding Path="MyFuncViewModel.UseBuildingFunction" />
              <!-- 2. CalculationBasis == Individual -> benutzt BuildingFunctionCalculationBasisToBooleanNotConverter -->
              <Binding Path="MyFuncViewModel.CalculationBasis" Converter="{StaticResource BuildingFunctionCalculationBasisToBooleanNotConverter}" ConverterParameter="Individual" />
            </MultiBinding>
          </ComboBox.IsEnabled>
          <ComboBoxItem Content="x000"></ComboBoxItem>
          <ComboBoxItem Content="xx00"></ComboBoxItem>
          <ComboBoxItem Content="xxx0"></ComboBoxItem>
          <ComboBoxItem Content="xxxx"></ComboBoxItem>
        </ComboBox>
      </Grid>

      <Grid x:Name="gridFilterBuildingFunction">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--row 0-->
        <Label Grid.Row="0"
               Grid.Column="1"
               Style="{StaticResource HeaderLabel1}">Count</Label>
        <Label Grid.Row="0"
               Grid.Column="2"
               Style="{StaticResource HeaderLabel1}">Usage Profiles</Label>
        <Label Grid.Row="0"
               Grid.Column="3"
               HorizontalAlignment="Center"
               Style="{StaticResource HeaderLabel1}">Use</Label>
        <Label Grid.Row="0"
               Grid.Column="4"
               HorizontalAlignment="Center"
               Style="{StaticResource HeaderLabel1}">Info</Label>

      </Grid>

      <ItemsControl ItemsSource="{Binding MyFuncViewModel.FuncEntries}"
                    IsEnabled="{Binding MyFuncViewModel.UseBuildingFunction}"
                    x:Name="itemsFuncFilterRows">
        <ItemsControl.Resources>
          <Style TargetType="Label">
            <Setter Property="Padding" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Right"/>
          </Style>
          <Style TargetType="TextBox">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="24" />
          </Style>
          <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="2" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Height" Value="24" />
          </Style>
          <Style TargetType="CheckBox">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
          </Style>
          <Style TargetType="Image">
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform"/>
          </Style>
        </ItemsControl.Resources>

        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Label Grid.Column="0"
                       Content="{Binding Title}"/>

              <TextBox Grid.Column="1"
                         Text="{Binding Count}"
                         IsEnabled="{Binding IsEnabled}"
                         IsReadOnly="True"/>

              <ComboBox Grid.Column="2"
                          IsEnabled="{Binding IsEnabled}"
                          ItemsSource="{Binding AvailableUsageProfiles}"
                          SelectedIndex="{Binding SelectedFunctionIndex}"
                          DisplayMemberPath="Key"
                          SelectionChanged="Combo_SelectionChanged_UpdateCheckbox"/>

              <CheckBox Grid.Column="3"
                          IsEnabled="{Binding IsEnabled}"
                          IsChecked="{Binding UseThisEntry}"
                          Checked="CheckBox_BuildingFunction"
                          Unchecked="CheckBox_BuildingFunction"/>

              <Image Grid.Column="4"
                       Height="24"
                       Source="../Resources/info.png"
                       Tag="BuildingFunction"
                       ToolTip=""
                       ToolTipOpening="Image_ToolTipOpening" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>

      </ItemsControl>

      <StackPanel>
        <Rectangle/>
      </StackPanel>

    </StackPanel>
  </Expander>

</local:BaseUserControl>
