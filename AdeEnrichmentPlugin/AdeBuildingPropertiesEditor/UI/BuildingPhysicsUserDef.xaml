<local:BaseUserControl x:Class="KIT.BuW.AdvEnrichment.UI.BuildingPhysicsUserDef"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Expander>
    <Expander.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="..\Resources\Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Expander.Resources>

    <Expander.Header>
      <Label Content="Building Physics"
                       Style="{StaticResource Heading1}" />
    </Expander.Header>

    <StackPanel Orientation="Vertical">
      <StackPanel.Resources>
        <Style TargetType="Label">
          <Setter Property="Padding"
                        Value="5" />
        </Style>
        <Style TargetType="TextBox">
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="Margin"
                        Value="3" />
          <Setter Property="FontWeight"
                        Value="Bold" />
        </Style>
        <Style TargetType="ComboBox">
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="FontWeight"
                        Value="Bold" />
          <Setter Property="Margin"
                        Value="3" />
        </Style>
        <Style TargetType="CheckBox">
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="Margin"
                        Value="3" />
          <Setter Property="VerticalAlignment"
                        Value="Center" />
          <Setter Property="HorizontalAlignment"
                        Value="Center" />
        </Style>
        <Style TargetType="Image">
          <Setter Property="Height"
                        Value="24" />
        </Style>
        <Style TargetType="RadioButton">
          <Setter Property="Margin"
                        Value="3 10 3 3" />
        </Style>
      </StackPanel.Resources>

      <Grid x:Name="gridPropertiesUValue">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="1"
                         Grid.Column="1"
                         Style="{StaticResource HeaderLabel1}">Value</Label>
        <Label Grid.Row="1"
                         Grid.Column="2"
                         Style="{StaticResource HeaderLabel1}">UoM</Label>
        <Label Grid.Row="1"
                         Grid.Column="3"
                         HorizontalAlignment="Center"
                         Style="{StaticResource HeaderLabel1}">Use</Label>
        <Label Grid.Row="1"
                         Grid.Column="4"
                         HorizontalAlignment="Center"
                         Style="{StaticResource HeaderLabel1}">Info</Label>

        <Label Grid.Row="2"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Construction Weight" />
        <Label Grid.Row="3"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="U-Value Walls" />
        <Label Grid.Row="4"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="U-Value Roofs" />
        <Label Grid.Row="5"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="U-Value Ground Plates" />
        <Label Grid.Row="6"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="U-Value Windows" />
        <Label Grid.Row="7"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="U-Value Doors" />

        <ComboBox x:Name="ConstructionWeight_Value"
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding Path=DefaultParameters.ConstructionWeight}"
                            SelectedValue="heavy"
                            SelectionChanged="ComboBox_SelectionChanged">
          <ComboBoxItem Content="veryLight"></ComboBoxItem>
          <ComboBoxItem Content="light"></ComboBoxItem>
          <ComboBoxItem Content="medium"></ComboBoxItem>
          <ComboBoxItem Content="heavy"></ComboBoxItem>
        </ComboBox>
        <TextBox Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.UValueWalls.Value}"
                           TextChanged="TextBox_TextChanged_1" />
        <TextBox Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.UValueRoofs.Value}"
                           TextChanged="TextBox_TextChanged_1" />
        <TextBox Grid.Row="5"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.UValueGroundPlates.Value}"
                           TextChanged="TextBox_TextChanged_1" />
        <TextBox Grid.Row="6"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.UValueWindows.Value}"
                           TextChanged="TextBox_TextChanged_1" />
        <TextBox Grid.Row="7"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.UValueDoors.Value}"
                           TextChanged="TextBox_TextChanged_1" />

        <RadioButton Grid.Column="1"
                               x:Name="rbSelectByUValues"
                               GroupName="BuildingPhysics"
                               Content="Select by U-Values"
                               IsThreeState="True"
                               Checked="RadioButton_UValue_Checked" />
        <TextBox Grid.Row="3"
                           Grid.Column="2"
                           Text="{Binding Path=DefaultParameters.UValueWalls.Uom}" />
        <TextBox Grid.Row="4"
                           Grid.Column="2"
                           Text="{Binding Path=DefaultParameters.UValueRoofs.Uom}" />
        <TextBox Grid.Row="5"
                           Grid.Column="2"
                           Text="{Binding Path=DefaultParameters.UValueGroundPlates.Uom}" />
        <TextBox Grid.Row="6"
                           Grid.Column="2"
                           Text="{Binding Path=DefaultParameters.UValueWindows.Uom}" />
        <TextBox Grid.Row="7"
                           Grid.Column="2"
                           Text="{Binding Path=DefaultParameters.UValueDoors.Uom}" />

        <Image Grid.Row="2"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="ConstructionWeight"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="3"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="UValueWalls"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="4"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="UValueRoofs"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="5"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="UValueGroundPlates"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="6"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="UValueWindows"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="7"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="UValueDoors"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
      </Grid>
      <Grid x:Name="gridPropertiesConstruction">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="1"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Construction Types" />
        <Label Grid.Row="2"
                         Grid.Column="1"
                         Style="{StaticResource HeaderLabel1}">Value</Label>
        <Label Grid.Row="2"
                         Grid.Column="4"
                         HorizontalAlignment="Center"
                         Style="{StaticResource HeaderLabel1}">Info</Label>

        <Label Grid.Row="3"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Construction Walls" />
        <Label Grid.Row="4"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Construction Roofs" />
        <Label Grid.Row="5"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Construction Ground Plates" />
        <Label Grid.Row="6"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Construction Windows" />

        <ComboBox Grid.Row="1"
                            Grid.Column="1"
                            ItemsSource="{Binding myConstructionList.ConstructionSets}"
                            DisplayMemberPath="Key"
                            SelectedValuePath="Value"
                            SelectionChanged="ComboBox_ConstructionSets_SelectionChanged"
                            Grid.ColumnSpan="2">
        </ComboBox>
        <ComboBox Grid.Row="3"
                            Grid.Column="1"
                            ItemsSource="{Binding Path=myWallConstructions}"
                            DisplayMemberPath="Key"
                            SelectedValuePath="Value"
                            x:Name="WallConstructionList"
                            SelectionChanged="ComboBox_Construction_SelectionChanged">
        </ComboBox>
        <ComboBox Grid.Row="4"
                            Grid.Column="1"
                            ItemsSource="{Binding Path=myRoofConstructions}"
                            DisplayMemberPath="Key"
                            SelectedValuePath="Value"
                            x:Name="RoofConstructionList"
                            SelectionChanged="ComboBox_Construction_SelectionChanged">
        </ComboBox>
        <ComboBox Grid.Row="5"
                            Grid.Column="1"
                            ItemsSource="{Binding Path=myGroundPlateConstructions}"
                            DisplayMemberPath="Key"
                            SelectedValuePath="Value"
                            x:Name="GroundPlateConstructionList"
                            SelectionChanged="ComboBox_Construction_SelectionChanged">
        </ComboBox>
        <ComboBox Grid.Row="6"
                            Grid.Column="1"
                            ItemsSource="{Binding Path=myWindowConstructions}"
                            DisplayMemberPath="Key"
                            SelectedValuePath="Value"
                            x:Name="WindowConstructionList"
                            SelectionChanged="ComboBox_Construction_SelectionChanged">
        </ComboBox>
        <RadioButton Grid.Row="0"
                               Grid.Column="1"
                               GroupName="BuildingPhysics"
                               Content="Select by Construction"
                               IsThreeState="True"
                               Checked="RadioButton_Construction_Checked" />
        <Button Grid.Row="3"
                          Grid.Column="2"
                          Content="Edit"
                          HorizontalAlignment="Center"
                          Width="60"
                          Click="Button_Click_Edit_Construction"/>
        <Button Grid.Row="4"
                          Grid.Column="2"
                          Content="Edit"
                          HorizontalAlignment="Center"
                          Width="60"
                          Click="Button_Click_Edit_Construction"/>
        <Button Grid.Row="5"
                          Grid.Column="2"
                          Content="Edit"
                          HorizontalAlignment="Center"
                          Width="60"
                          Click="Button_Click_Edit_Construction"/>
        <Button Grid.Row="6"
                          Grid.Column="2"
                          Content="Edit"
                          HorizontalAlignment="Center"
                          Width="60"
                          Click="Button_Click_Edit_Construction"/>

        <Image Grid.Row="3"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="ConstructionWalls"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="4"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="ConstructionRoofs"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="5"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="ConstructionGroundPlates"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="6"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="ConstructionWindows"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
      </Grid>
      <StackPanel>
        <Rectangle />
      </StackPanel>
    </StackPanel>
  </Expander>


</local:BaseUserControl>
