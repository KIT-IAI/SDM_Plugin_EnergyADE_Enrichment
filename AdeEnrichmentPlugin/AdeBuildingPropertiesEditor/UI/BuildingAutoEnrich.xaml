<local:BaseUserControl x:Class="KIT.BuW.AdvEnrichment.UI.BuildingAutoEnrich"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Expander IsExpanded="True">
    <Expander.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="..\Resources\Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Expander.Resources>

    <Expander.Header>
      <Label Content="Building"
                       Style="{StaticResource Heading1}" />
    </Expander.Header>
    
    <StackPanel Orientation="Vertical">
      <StackPanel.Resources>
        <Style TargetType="Label">
          <Setter Property="Padding"
                        Value="5" />
        </Style>
        <Style TargetType="TextBox">
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="Margin"
                        Value="3" />
          <Setter Property="FontWeight"
                        Value="Bold" />
        </Style>
        <Style TargetType="ComboBox">
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="FontWeight"
                        Value="Bold" />
          <Setter Property="Margin"
                        Value="3" />
        </Style>
        <Style TargetType="CheckBox">
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="Margin"
                        Value="3" />
          <Setter Property="VerticalAlignment"
                        Value="Center" />
          <Setter Property="HorizontalAlignment"
                        Value="Center" />
        </Style>
        <Style TargetType="Image">
          <Setter Property="Height"
                        Value="24" />
        </Style>
        <Style TargetType="RadioButton">
          <Setter Property="Margin"
                        Value="3 10 3 3" />
        </Style>
        <Style TargetType="TextBox" x:Key="RedBackgroundOnErrorStyle">
          <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter Property="Background" Value="#f88"/>
            </Trigger>
          </Style.Triggers>
          <Setter Property="Padding"
                        Value="2" />
          <Setter Property="Margin"
                        Value="3" />
          <Setter Property="FontWeight"
                        Value="Bold" />
        </Style>
      </StackPanel.Resources>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
                         Grid.Column="1"
                         Style="{StaticResource HeaderLabel1}">Value</Label>
        <Label Grid.Row="0"
                         Grid.Column="2"
                         Style="{StaticResource HeaderLabel1}">UoM</Label>
        <Label Grid.Row="0"
                         Grid.Column="3"
                         HorizontalAlignment="Center"
                         Style="{StaticResource HeaderLabel1}">Use</Label>
        <Label Grid.Row="0"
                         Grid.Column="4"
                         HorizontalAlignment="Center"
                         Style="{StaticResource HeaderLabel1}">Info</Label>

        <Label Grid.Row="1"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Walls Opening Percentage" />
        <Label Grid.Row="2"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Roof Opening Percentage" />
        <Label Grid.Row="3"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Storey Height" />
        <Label Grid.Row="4"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Floor Area Ratio" />
        <Label Grid.Row="5"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Air Infiltration Rate" />

        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 x:Name="txtOPWalls"
                 TextChanged="AutoEnrich_TextBox_TextChanged"
                 LostFocus="AutoEnrich_TextBox_LostFocus"
                 Style="{StaticResource RedBackgroundOnErrorStyle}">
          <TextBox.Text>
            <Binding Path="autoEnrichViewModel.OpeningPercentageWallsText_" 
                     UpdateSourceTrigger="PropertyChanged">
              <Binding.ValidationRules>
                <local:NumericValidationRule ValidationStep="ConvertedProposedValue" 
                                             Min="0" Max="100"/>
              </Binding.ValidationRules>
            </Binding>
          </TextBox.Text>
        </TextBox>

        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 x:Name="txtOPRoofs"
                 TextChanged="AutoEnrich_TextBox_TextChanged"
                 LostFocus="AutoEnrich_TextBox_LostFocus"
                 Style="{StaticResource RedBackgroundOnErrorStyle}">
          <TextBox.Text>
            <Binding Path="autoEnrichViewModel.OpeningPercentageRoofsText_" 
                     UpdateSourceTrigger="PropertyChanged">
              <Binding.ValidationRules>
                <local:NumericValidationRule ValidationStep="ConvertedProposedValue" 
                                             Min="0" Max="100"/>
              </Binding.ValidationRules>
            </Binding>
          </TextBox.Text>
        </TextBox>
        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 x:Name="txtStoreyHeight"
                 TextChanged="AutoEnrich_TextBox_TextChanged"
                 LostFocus="AutoEnrich_TextBox_LostFocus"
                 Style="{StaticResource RedBackgroundOnErrorStyle}">
          <TextBox.Text>
            <Binding Path="autoEnrichViewModel.StoreyHeightText_" 
                     UpdateSourceTrigger="PropertyChanged">
              <Binding.ValidationRules>
                <local:NumericValidationRule ValidationStep="ConvertedProposedValue" 
                                             Min="0" Max="25"/>
              </Binding.ValidationRules>
            </Binding>
          </TextBox.Text>
        </TextBox>
        <TextBox Grid.Row="4"
                 Grid.Column="1"
                 x:Name="txtFloorAreaRatio"
                 TextChanged="AutoEnrich_TextBox_TextChanged"
                 LostFocus="AutoEnrich_TextBox_LostFocus"
                 Style="{StaticResource RedBackgroundOnErrorStyle}">
          <TextBox.Text>
            <Binding Path="autoEnrichViewModel.FloorAreaRatioText_" 
                     UpdateSourceTrigger="PropertyChanged">
              <Binding.ValidationRules>
                <local:NumericValidationRule ValidationStep="ConvertedProposedValue" 
                                             Min="0" Max="1"/>
              </Binding.ValidationRules>
            </Binding>
          </TextBox.Text>
        </TextBox>
        <TextBox Grid.Row="5"
                 Grid.Column="1"
                 x:Name="txtAirInfiltrationRate"
                 TextChanged="AutoEnrich_TextBox_TextChanged"
                 LostFocus="AutoEnrich_TextBox_LostFocus"
                 Style="{StaticResource RedBackgroundOnErrorStyle}">
          <TextBox.Text>
            <Binding Path="autoEnrichViewModel.AirInfiltrationRateText_" 
                     UpdateSourceTrigger="PropertyChanged">
              <Binding.ValidationRules>
                <local:NumericValidationRule ValidationStep="ConvertedProposedValue" 
                                             Min="0" Max="1"/>
              </Binding.ValidationRules>
            </Binding>
          </TextBox.Text>
        </TextBox>

        <Label Grid.Row="1"
               Grid.Column="2">%</Label>
        <Label Grid.Row="2"
               Grid.Column="2">%</Label>
        <TextBox Grid.Row="3"
                 Grid.Column="2"
                 Text="{Binding Path=autoEnrichViewModel.StoreyHeightUom}" />
        <Label Grid.Row="4"
               Grid.Column="2"></Label>
        <TextBox Grid.Row="5"
                 Grid.Column="2"
                 Text="{Binding Path=autoEnrichViewModel.AirInfiltrationRateUom}" />

        <CheckBox Grid.Row="1"
                  Grid.Column="3"
                  IsChecked="{Binding Path=autoEnrichViewModel.UseOpeningPercentageWalls}" />
        <CheckBox Grid.Row="2"
                  Grid.Column="3"
                  IsChecked="{Binding Path=autoEnrichViewModel.UseOpeningPercentageRoofs}" />
        <CheckBox Grid.Row="3"
                  Grid.Column="3"
                  IsChecked="{Binding Path=autoEnrichViewModel.UseStoreyHeight}" />
        <CheckBox Grid.Row="4"
                  Grid.Column="3"
                  IsChecked="{Binding Path=autoEnrichViewModel.UseFloorAreaRatio}" />
        <CheckBox Grid.Row="5"
                  Grid.Column="3"
                  IsChecked="{Binding Path=autoEnrichViewModel.UseAirInfiltrationRate}" />

        <Image Grid.Row="1"
               Grid.Column="4"
               Source="../Resources/info.png"
               Tag="WallsOpeningPercentage"
               ToolTip=""
               ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="2"
               Grid.Column="4"
               Source="../Resources/info.png"
               Tag="RoofOpeningPercentage"
               ToolTip=""
               ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="3"
               Grid.Column="4"
               Source="../Resources/info.png"
               Tag="DefaultStoreyHeight"
               ToolTip=""
               ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="4"
               Grid.Column="4"
               Source="../Resources/info.png"
               Tag="DefaultFloorAreaRatio"
               ToolTip=""
               ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="5"
               Grid.Column="4"
               Source="../Resources/info.png"
               Tag="DefaultAirInfiltrationRate"
               ToolTip=""
               ToolTipOpening="Image_ToolTipOpening" />
      </Grid>

      <StackPanel>
        <Rectangle/>
      </StackPanel>

    </StackPanel>
  </Expander>


</local:BaseUserControl>
