<UserControl x:Class="KIT.BuW.AdvEnrichment.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Expander IsExpanded="True">
    <Expander.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="..\Resources\Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Expander.Resources>

    <Expander.Header>
      <Label Content="Global Settings"
             Style="{StaticResource Heading1}" />
    </Expander.Header>

    <StackPanel Orientation="Vertical">
      <Label Content="Thermal Zone Settings" FontWeight="Bold" Margin="5"/>
      <RadioButton Content="Thermal Zone per Building" GroupName="ThermalZoneGroup" Margin="5" IsChecked="{Binding GlobalSettingsViewModel.ThermalZonesByBuilding}"/>
      <RadioButton Content="Thermal Zone per BuildingPart" GroupName="ThermalZoneGroup" Margin="5" IsChecked="{Binding GlobalSettingsViewModel.ThermalZonesByBuildingPart}"/>
      <RadioButton Content="ThermalZone per Storey" GroupName="ThermalZoneGroup" Margin="5" IsChecked="{Binding GlobalSettingsViewModel.ThermalZonesByStorey}" IsEnabled="False"/>
      <Label Content="Geometry Settings" FontWeight="Bold" Margin="5"/>
      <CheckBox Content="Split Building Geometry by Storey" Margin="5" IsChecked="{Binding GlobalSettingsViewModel.SplitGeometryIntoStoreys}" IsEnabled="False"/>
    </StackPanel>
  </Expander>
</UserControl>