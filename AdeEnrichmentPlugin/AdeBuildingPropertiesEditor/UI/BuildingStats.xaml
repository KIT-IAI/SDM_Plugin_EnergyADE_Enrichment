<UserControl x:Class="KIT.BuW.AdvEnrichment.UI.BuildingStats"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Expander IsExpanded="True">
    <Expander.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="..\Resources\Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Expander.Resources>

    <Expander.Header>
      <Label Content="Building"
                       Style="{StaticResource Heading1}" />
    </Expander.Header>

    <StackPanel Orientation="Vertical">
      <Grid>
        <Grid.Resources>
          <Style TargetType="{x:Type Label}">
            <Setter Property="Padding"
                              Value="5" />
          </Style>
          <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding"
                              Value="2" />
            <Setter Property="Margin"
                              Value="3" />
            <Setter Property="HorizontalAlignment"
                              Value="Stretch" />
            <Setter Property="HorizontalContentAlignment"
                              Value="Right" />
            <Setter Property="FontWeight"
                              Value="Bold" />
          </Style>
          <Style TargetType="Rectangle">
            <Setter Property="Height"
                              Value="2" />
            <Setter Property="Fill"
                              Value="LightBlue" />
            <Setter Property="Margin"
                              Value="100 8" />
          </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Total Number of Buildings" />
        <Label Grid.Row="1"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="With Geometry" />
        <Label Grid.Row="2"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Without Geometry" />
        <Label Grid.Row="4"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="With GML Solid" />
        <Label Grid.Row="4"
                         Grid.Column="2"
                         HorizontalAlignment="Right"
                         Content="Correct Solid" />
        <Label Grid.Row="5"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="With Solid by Boundary Surfaces" />
        <Label Grid.Row="7"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="With bldg:YearOfConstruction" />
        <Label Grid.Row="8"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="With bldg:function" />

        <TextBox Grid.Row="0"
                           Grid.Column="1"
                           IsReadOnly="True"
                           Text="{Binding Path=BuildingStats.TotalBuildings, Mode=OneTime}" />
        <DockPanel Grid.Row="1"
                             Grid.Column="1">
          <Label Content="LoD0" />
          <TextBox HorizontalAlignment="Stretch"
                             Width="auto"
                             IsReadOnly="True"
                             Text="{Binding BuildingStats.BuildingsWithLod0, Mode=OneTime}" />
        </DockPanel>
        <DockPanel Grid.Row="1"
                             Grid.Column="2">
          <Label Content="LoD1" />
          <TextBox HorizontalAlignment="Stretch"
                             Width="auto"
                             IsReadOnly="True"
                             Text="{Binding BuildingStats.BuildingsWithLod1, Mode=OneTime}" />
        </DockPanel>
        <DockPanel Grid.Row="1"
                             Grid.Column="3">
          <Label Content="LoD2" />
          <TextBox HorizontalAlignment="Stretch"
                             Width="auto"
                             IsReadOnly="True"
                             Text="{Binding BuildingStats.BuildingsWithLod2, Mode=OneTime}" />
        </DockPanel>
        <DockPanel Grid.Row="1"
                             Grid.Column="4">
          <Label Content="LoD3" />
          <TextBox HorizontalAlignment="Stretch"
                             Width="auto"
                             IsReadOnly="True"
                             Text="{Binding BuildingStats.BuildingsWithLod3, Mode=OneTime}" />
        </DockPanel>
        <DockPanel Grid.Row="1"
                             Grid.Column="5">
          <Label Content="LoD4" />
          <TextBox HorizontalAlignment="Stretch"
                             Width="auto"
                             IsReadOnly="True"
                             Text="{Binding BuildingStats.BuildingsWithLod4, Mode=OneTime}" />
        </DockPanel>
        <TextBox Grid.Row="2"
                           Grid.Column="1"
                           IsReadOnly="True"
                           Text="{Binding BuildingStats.BuildingsNoGeometry, Mode=OneTime}" />
        <TextBox Grid.Row="4"
                           Grid.Column="1"
                           IsReadOnly="True"
                           Text="{Binding Path=BuildingStats.BuildingsWithSolid, Mode=OneTime}" />
        <TextBox Grid.Row="4"
                           Grid.Column="3"
                           IsReadOnly="True"
                           Text="{Binding Path=BuildingStats.BuildingsWithCorrectSolid, Mode=OneTime}" />
        <TextBox Grid.Row="5"
                           Grid.Column="1"
                           IsReadOnly="True"
                           Text="{Binding Path=BuildingStats.BuildingsWithSurface, Mode=OneTime}" />
        <TextBox Grid.Row="7"
                           Grid.Column="1"
                           IsReadOnly="True"
                           Text="{Binding Path=BuildingStats.BuildingsWithYear, Mode=OneTime}" />
        <TextBox Grid.Row="8"
                           Grid.Column="1"
                           IsReadOnly="True"
                           Text="{Binding Path=BuildingStats.BuildingsWithFunction, Mode=OneTime}" />

        <Rectangle Grid.Row="3"
                             Grid.Column="0"
                             Grid.ColumnSpan="6" />
        <Rectangle Grid.Row="6"
                             Grid.Column="0"
                             Grid.ColumnSpan="6" />

        <!--<TextBox Grid.Row="1"
                     Grid.Column="2"
                     IsReadOnly="True"
                     Text="{Binding Path=BuildingStats.TotalBuildings, Mode=OneTime}" />-->
      </Grid>
      <Rectangle />
    </StackPanel>
  </Expander>

</UserControl>
