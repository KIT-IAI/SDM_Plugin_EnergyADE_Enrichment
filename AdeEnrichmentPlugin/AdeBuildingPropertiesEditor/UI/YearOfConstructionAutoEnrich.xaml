<local:BaseUserControl x:Class="KIT.BuW.AdvEnrichment.UI.YearOfConstructionAutoEnrich"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.UI"
             xmlns:res="clr-namespace:KIT.BuW.AdvEnrichment"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Expander IsExpanded="{Binding MyYocViewModel.IsExpanded}"
            d:IsExpanded="True">
    <Expander.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="BaseUserControlResources.xaml" />
          <ResourceDictionary Source="..\Resources\Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Expander.Resources>

    <Expander.Header>
      <Label Content="Year of Construction"
             Style="{StaticResource Heading1}"/>
    </Expander.Header>

    <StackPanel Orientation="Vertical">
      <StackPanel.Resources>
        <Style TargetType="Label">
          <Setter Property="Padding" Value="5" />
        </Style>
        <Style TargetType="TextBox">
          <Setter Property="Padding" Value="2" />
          <Setter Property="Margin" Value="3" />
          <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="ComboBox">
          <Setter Property="Padding" Value="2" />
          <Setter Property="FontWeight" Value="Bold" />
          <Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="CheckBox">
          <Setter Property="Padding" Value="2" />
          <Setter Property="Margin" Value="3" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Image">
          <Setter Property="Height" Value="24" />
        </Style>
        <Style TargetType="RadioButton">
          <Setter Property="Margin" Value="3 10 3 3" />
        </Style>
        <Style TargetType="Button">
          <Setter Property="Margin" Value="3 0"/>
        </Style>
      </StackPanel.Resources>

      <Grid x:Name="gridYearOfConstruction">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="128*" />
          <ColumnDefinition Width="8*"/>
          <ColumnDefinition Width="271*" />
          <ColumnDefinition Width="271*" />
          <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  -->
        <CheckBox Grid.Row="0"
                  Grid.Column="0"
                  HorizontalAlignment="Right"
                  IsChecked="{Binding MyYocViewModel.UseYearOfConstruction}" 
                  Checked="CheckBox_Use_YearOfConstruction"
                  Unchecked="CheckBox_Use_YearOfConstruction"
                  VerticalAlignment="Top"
                  Margin="0,5"/>
        <Label Grid.Row="0"
               Grid.Column="2"
               HorizontalAlignment="Left"
               Content="Include year of construction"/>
        <StackPanel Orientation="Vertical"
                    Grid.Row="0"
                    Grid.Column="3">
          <Button Visibility="{Binding Path=YearOfConstructionStats.UIVisibility}"
                  Content="Enrich Year of Construction (FZJ ETHOS-BUILDA)" 
                  Name="Button_Enrich"
                  Click="Button_Click"/>
          <Label Grid.Row="1"
                 Grid.Column="2"
                 Visibility="{Binding Path=YearOfConstructionStats.UIVisibility}"
                 Content="Only Residental Buildings are available"/>
        </StackPanel>


        <!-- This dataase is currently not supported! -->
        <RadioButton Grid.Row="1"
                     Grid.Column="2"
                     Content="Constructions based on DENA"
                     IsThreeState="False"
                     IsChecked="{Binding MyYocViewModel.ConstructionBasis, Converter={StaticResource ConstructionDefinitionTypeToBooleanConverter}, ConverterParameter=DENA, Mode=TwoWay}"
                     IsEnabled="{Binding MyYocViewModel.UseYearOfConstruction}"
                     Checked="RadioButton_ConstructionBasis" 
                     Visibility="Collapsed" 
                     Margin="3,10,3,18" 
                     Grid.RowSpan="2"/>

        <!--  -->
        <RadioButton Grid.Row="2"
                     Grid.Column="2"
                     Content="Constructions based on TABULA"
                     IsThreeState="False"
                     IsChecked="{Binding MyYocViewModel.ConstructionBasis, Converter={StaticResource ConstructionDefinitionTypeToBooleanConverter}, ConverterParameter=TABULA, Mode=TwoWay}"
                     IsEnabled="{Binding MyYocViewModel.UseYearOfConstruction}"
                     Checked="RadioButton_ConstructionBasis" 
                     Margin="3,10,3,3" />
        <!--  -->
        <RadioButton Grid.Row="3"
                     Grid.Column="2"
                     Content="Individual construction definition"
                     IsThreeState="False"
                     IsChecked="{Binding MyYocViewModel.ConstructionBasis, Converter={StaticResource ConstructionDefinitionTypeToBooleanConverter}, ConverterParameter=USER_DEFINED, Mode=TwoWay}"
                     IsEnabled="{Binding MyYocViewModel.UseYearOfConstruction}"
                     Checked="RadioButton_ConstructionBasis" 
                     Margin="3,10,3,3" />
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="5*"/>
          <ColumnDefinition Width="60"/>
          <ColumnDefinition Width="60"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0"
               Grid.Column="1"
               Style="{StaticResource HeaderLabel1}">Count</Label>
        <Label Grid.Row="0"
               Grid.Column="2"
               Style="{StaticResource HeaderLabel1}">Constructions</Label>
        <Label Grid.Row="0"
               Grid.Column="3"
               HorizontalAlignment="Center"
               Style="{StaticResource HeaderLabel1}">Use</Label>
        <Label Grid.Row="0"
               Grid.Column="4"
               HorizontalAlignment="Center"
               Style="{StaticResource HeaderLabel1}">Info</Label>
      </Grid>

      <ItemsControl ItemsSource="{Binding Path=MyYocViewModel.YocEntries}"
                    x:Name="YocFilterRows"
                    IsEnabled="{Binding MyYocViewModel.UseYearOfConstruction}">
        <ItemsControl.Resources>
          <Style TargetType="Label">
            <Setter Property="Padding" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Right"/>
          </Style>
          <Style TargetType="TextBox">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="24" />
          </Style>
          <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="2" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Height" Value="24" />
          </Style>
          <Style TargetType="CheckBox">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
          </Style>
          <Style TargetType="Image">
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform"/>
          </Style>
        </ItemsControl.Resources>

        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Label Grid.Column="0"
                     Content="{Binding Title}"/>

              <TextBox Grid.Column="1"
                       Text="{Binding Count}"
                       IsEnabled="{Binding IsEnabled}"
                       IsReadOnly="True"/>

              <!--ItemsSource="{Binding Path=DataContext.myConstructionList.ConstructionSets, RelativeSource={RelativeSource AncestorType=Window}}"-->
              <ComboBox Grid.Column="2"
                        IsEnabled="{Binding IsEnabled}"
                        ItemsSource="{Binding AvailableConstructions}"
                        SelectedIndex="{Binding SelectedConstructionIndex}"
                        DisplayMemberPath="Key"
                        SelectionChanged="Combo_SelectionChanged_UpdateCheckbox"/>

              <CheckBox Grid.Column="3"
                        IsEnabled="{Binding IsEnabled}"
                        IsChecked="{Binding UseThisEntry}"
                        Checked="CheckBox_YearOfConstruction"
                        Unchecked="CheckBox_YearOfConstruction"/>

              <Image Grid.Column="4"
                     Height="24"
                     Source="../Resources/info.png"
                     Tag="YearOfConstruction"
                     ToolTip=""
                     ToolTipOpening="Image_ToolTipOpening" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel>
        <Rectangle />
      </StackPanel>
    </StackPanel>
  </Expander>


</local:BaseUserControl>
