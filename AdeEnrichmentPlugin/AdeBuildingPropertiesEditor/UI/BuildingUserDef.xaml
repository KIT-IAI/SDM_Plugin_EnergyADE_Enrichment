<local:BaseUserControl x:Class="KIT.BuW.AdvEnrichment.UI.BuildingUserDef"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KIT.BuW.AdvEnrichment.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Expander IsExpanded="True">
    <Expander.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="..\Resources\Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Expander.Resources>

    <Expander.Header>
      <Label Content="Building"
                       Style="{StaticResource Heading1}" />
    </Expander.Header>
    
    <StackPanel Orientation="Vertical">
      <StackPanel.Resources>
        <Style TargetType="Label">
          <Setter Property="Padding"
            Value="5" />
        </Style>
        <Style TargetType="TextBox">
          <Setter Property="Padding"
            Value="2" />
          <Setter Property="Margin"
            Value="3" />
          <Setter Property="FontWeight"
            Value="Bold" />
        </Style>
        <Style TargetType="ComboBox">
          <Setter Property="Padding"
            Value="2" />
          <Setter Property="FontWeight"
            Value="Bold" />
          <Setter Property="Margin"
            Value="3" />
        </Style>
        <Style TargetType="CheckBox">
          <Setter Property="Padding"
            Value="2" />
          <Setter Property="Margin"
            Value="3" />
          <Setter Property="VerticalAlignment"
            Value="Center" />
          <Setter Property="HorizontalAlignment"
            Value="Center" />
        </Style>
        <Style TargetType="Image">
          <Setter Property="Height"
            Value="24" />
        </Style>
        <Style TargetType="RadioButton">
          <Setter Property="Margin"
            Value="3 10 3 3" />
        </Style>
      </StackPanel.Resources>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="60" />
          <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
                         Grid.Column="1"
                         Style="{StaticResource HeaderLabel1}">Value</Label>
        <Label Grid.Row="0"
                         Grid.Column="2"
                         Style="{StaticResource HeaderLabel1}">UoM</Label>
        <Label Grid.Row="0"
                         Grid.Column="3"
                         HorizontalAlignment="Center"
                         Style="{StaticResource HeaderLabel1}">Use</Label>
        <Label Grid.Row="0"
                         Grid.Column="4"
                         HorizontalAlignment="Center"
                         Style="{StaticResource HeaderLabel1}">Info</Label>

        <Label Grid.Row="1"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Building Function" />
        <Label Grid.Row="2"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Year of Construction" />
        <Label Grid.Row="3"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Walls Opening Percentage" />
        <Label Grid.Row="4"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Roof Opening Percentage" />
        <Label Grid.Row="5"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Floor Area Ratio" />
        <Label Grid.Row="6"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Storey Height" />
        <Label Grid.Row="7"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Air Infiltration Rate" />
        <Label Grid.Row="8"
                         Grid.Column="0"
                         HorizontalAlignment="Right"
                         Content="Building Size Type" />

        <ComboBox Grid.Row="1"
                            Grid.Column="1"
                            x:Name="ComboBox_BuildingFunctions"
                            Text="{Binding Path=DefaultParameters.BuildingFunction}"/>
        <ComboBox x:Name="BuildingSize_Types"
                            Grid.Row="10"
                            Grid.Column="1"
                            SelectedValue="small"
                            Text="{Binding Path=DefaultParameters.BuildingSizeType}"
                            SelectionChanged="ComboBox_SelectionChanged">
          <ComboBoxItem Content="small"></ComboBoxItem>
          <ComboBoxItem Content="medium"></ComboBoxItem>
          <ComboBoxItem Content="large"></ComboBoxItem>
        </ComboBox>

        <TextBox Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.YearOfConstruction}"
                           TextChanged="TextBox_TextChanged_1" />
        <TextBox Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.OpeningPercentageWalls}"
                           TextChanged="TextBox_TextChanged_1" />
        <TextBox Grid.Row="4"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.OpeningPercentageRoofs}"
                           TextChanged="TextBox_TextChanged_1" />
        <TextBox Grid.Row="5"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.FloorAreaRatio.Value}"
                           TextChanged="TextBox_TextChanged_1" />
        <TextBox Grid.Row="6"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.StoreyHeight.Value}"
                           TextChanged="TextBox_TextChanged_1" />
        <TextBox Grid.Row="7"
                           Grid.Column="1"
                           Text="{Binding Path=DefaultParameters.AirInfiltrationRate.Value}"
                           TextChanged="TextBox_TextChanged_1" />

        <Label Grid.Row="2"
                         Grid.Column="2">Year</Label>
        <Label Grid.Row="3"
                         Grid.Column="2">%</Label>
        <Label Grid.Row="4"
                         Grid.Column="2">%</Label>
        <TextBox Grid.Row="6"
                           Grid.Column="2"
                           Text="{Binding Path=DefaultParameters.StoreyHeight.Uom}" />
        <TextBox Grid.Row="7"
                           Grid.Column="2"
                           Text="{Binding Path=DefaultParameters.AirInfiltrationRate.Uom}" />

        <CheckBox x:Name="Check_Building_Function"
                            Grid.Row="1"
                            Grid.Column="3"
                            IsChecked="False" />
        <CheckBox x:Name="Check_Year_of_constr"
                            Grid.Row="2"
                            Grid.Column="3"
                            IsChecked="False" />
        <CheckBox x:Name="Check_Walls_Open"
                            Grid.Row="3"
                            Grid.Column="3"
                            IsChecked="False" />
        <CheckBox x:Name="Check_Roof_Open"
                            Grid.Row="4"
                            Grid.Column="3"
                            IsChecked="False" />
        <CheckBox x:Name="Check_Floor_Area_Ratio"
                            Grid.Row="5"
                            Grid.Column="3"
                            IsChecked="False" />
        <CheckBox x:Name="Check_Storey_Height"
                            Grid.Row="6"
                            Grid.Column="3"
                            IsChecked="False" />
        <CheckBox x:Name="Check_Air_Infiltr_Rate"
                            Grid.Row="7"
                            Grid.Column="3"
                            IsChecked="False" />
        <CheckBox x:Name="Check_Build_Size"
                            Grid.Row="8"
                            Grid.Column="3"
                            IsChecked="False" />

        <Image Grid.Row="1"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="BuildingFunction"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="2"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="YearOfConstruction"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="3"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="WallsOpeningPercentage"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="4"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="RoofOpeningPercentage"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="5"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="FloorAreaRatio"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="6"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="StoreyHeight"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="7"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="AirInfiltrationRate"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
        <Image Grid.Row="8"
                         Grid.Column="4"
                         Source="../Resources/info.png"
                         Tag="BuildingSizeType"
                         ToolTip=""
                         ToolTipOpening="Image_ToolTipOpening" />
      </Grid>

      <StackPanel>
        <Rectangle/>
      </StackPanel>

    </StackPanel>
  </Expander>


</local:BaseUserControl>
